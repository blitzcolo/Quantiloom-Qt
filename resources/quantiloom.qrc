<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <!--
            The toolbar carries no bundled icons on purpose. Its file, undo,
            redo and render actions take their icons from QStyle, so they
            follow the active theme and stay legible against light and dark
            backgrounds; a fixed bitmap set would have to ship two variants and
            choose between them at runtime. The transform buttons deliberately
            have no icon at all, because a QToolButton falls back to the
            action's text, which is how they read as G / R / T.

            Add files here only for artwork that has no style equivalent, and
            keep the light/dark question in mind when you do.
        -->
    </qresource>

    <!-- Translations are added automatically by qt6_add_translation -->
    <qresource prefix="/i18n">
        <!-- Placeholder: the actual .qm files are generated by CMake -->
    </qresource>
</RCC>
