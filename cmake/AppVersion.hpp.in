// Generated by CMake from cmake/AppVersion.hpp.in -- do not edit.
//
// The application version, from project(QuantiloomQt VERSION ...) and nowhere
// else. It used to be typed into main.cpp and again into the About box, and the
// second copy was inside a tr() string -- so every bump silently invalidated the
// Chinese translation of that whole paragraph and it had to be rewritten.
//
// Only main.cpp reads this. Everything else asks
// QCoreApplication::applicationVersion(), which main.cpp sets from here.

#pragma once

namespace quantiloom_qt::version {

// e.g. "0.1.3". Matches the FILEVERSION in the generated QuantiloomQt.rc,
// because both come from the same project(VERSION).
inline constexpr const char* kAppVersion = "@PROJECT_VERSION@";

}  // namespace quantiloom_qt::version
